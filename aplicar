#!/usr/bin/env python3
"""Compara o servidor com este repositório: o que o instalador poria nele e o que está lá de verdade.

Uso:
  sudo ./aplicar --conferir             o que difere, o que falta e o que sobra, por parte (nada muda)
  sudo ./aplicar --conferir --diff      e, em cada arquivo diferente, o que mudaria (servidor -> repositório)
  sudo ./aplicar --conferir --parte executor,hermes
  sudo ./aplicar --conferir --copias    lista também as cópias antigas (.antes-*) que as trocas deixaram

Partes: host, executor, stacks, painel, hermes, lab. Os valores do servidor vêm do /etc/atena/atena.conf.
Sem sudo, o que só o root lê fica marcado com "?". Sai com 0 quando o servidor está igual ao repositório,
1 quando algo difere, 3 quando não deu para ler tudo (e o resto está igual) e 2 num erro.
"""
import argparse
import json
import os
import re
import subprocess
import sys

RAIZ = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(RAIZ, "install"))
import estado  # noqa: E402

ROTULOS = {"difere": "difere", "falta": "falta", "sobra": "sobra", "ilegivel": "?", "copia": "cópia"}
ORDEM = ("difere", "falta", "sobra", "ilegivel")


def versao_do_repositorio():
    git = ["git", "-c", f"safe.directory={RAIZ}", "-C", RAIZ]
    try:
        commit = subprocess.run(git + ["rev-parse", "--short", "HEAD"], capture_output=True, text=True, check=True)
        sujo = subprocess.run(git + ["status", "--porcelain", "--untracked-files=no"], capture_output=True, text=True)
    except (OSError, subprocess.CalledProcessError):
        return "(fora de um clone do git)"
    return commit.stdout.strip() + (" + mudanças não commitadas" if sujo.stdout.strip() else "")


def chaves_que_faltam(conf):
    """As chaves do atena.conf.example que o atena.conf do servidor não tem (valem os padrões)."""
    def chaves(caminho):
        with open(caminho) as f:
            return re.findall(r"^\s*(?:export\s+)?(ATENA_\w+)=", f.read(), re.M)
    try:
        do_servidor = set(chaves(conf))
        return [c for c in chaves(os.path.join(RAIZ, "atena.conf.example")) if c not in do_servidor]
    except OSError:
        return []


def principal(argv):
    p = argparse.ArgumentParser(prog="aplicar", description=__doc__.split("\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog="\n".join(__doc__.split("\n")[2:]))
    p.add_argument("--conferir", action="store_true", help="só compara; nada muda no servidor")
    p.add_argument("--diff", action="store_true", help="mostra o que mudaria em cada arquivo diferente")
    p.add_argument("--parte", default="", help="só estas partes, separadas por vírgula")
    p.add_argument("--copias", action="store_true", help="lista as cópias antigas (.antes-*)")
    p.add_argument("--json", action="store_true", help="o resultado em JSON")
    p.add_argument("--alvo", default="/", help="a raiz do servidor (padrão: /; ex.: uma cópia montada)")
    p.add_argument("--conf", help="o atena.conf (padrão: <alvo>/etc/atena/atena.conf)")
    p.add_argument("--sem-dono", action="store_true", help="não confere dono e grupo (numa cópia do servidor)")
    a = p.parse_args(argv)
    if not a.conferir:
        print("por enquanto, só o --conferir (compara sem mudar nada); a aplicação por partes vem depois",
              file=sys.stderr)
        return 2
    partes = [x for x in a.parte.split(",") if x]
    desconhecidas = [x for x in partes if x not in estado.PARTES]
    if desconhecidas:
        print(f"parte desconhecida: {', '.join(desconhecidas)} (partes: {', '.join(estado.PARTES)})", file=sys.stderr)
        return 2
    try:
        resultados, conf, tem = estado.conferir(RAIZ, a.alvo, a.conf, partes, donos=not a.sem_dono)
    except estado.ConfInvalida as e:
        print(f"erro: {e}", file=sys.stderr)
        return 2
    caminho_conf = a.conf or estado.no_alvo(a.alvo, "/etc/atena/atena.conf")
    contagem = {e: sum(1 for r in resultados if r.estado == e) for e in ("igual", *ORDEM, "copia")}

    if a.json:
        json.dump({"repositorio": versao_do_repositorio(), "alvo": a.alvo, "opcoes": tem, "contagem": contagem,
                   "resultados": [{"parte": r.parte, "caminho": r.caminho, "estado": r.estado, "origem": r.origem,
                                   "detalhes": r.detalhes} for r in resultados if r.estado != "igual"]},
                  sys.stdout, ensure_ascii=False, indent=1)
        print()
    else:
        print("Conferindo o servidor contra o repositório (nada muda)")
        print(f"  repositório  {RAIZ}  {versao_do_repositorio()}")
        print(f"  servidor     {a.alvo}  (valores de {caminho_conf})")
        com = [o for o, sim in tem.items() if sim]
        sem = [o for o, sim in tem.items() if not sim]
        print(f"  opções       {', '.join(com) or 'nenhuma'}" + (f"  (sem: {', '.join(sem)})" if sem else ""))
        faltam = chaves_que_faltam(caminho_conf)
        if faltam:
            print(f"  atena.conf   sem {', '.join(faltam)} (valem os padrões)")
        for parte, descricao in estado.PARTES.items():
            daqui = [r for r in resultados if r.parte == parte]
            if not daqui:
                continue
            print(f"\n{parte} · {descricao}")
            for e in ORDEM:
                for r in sorted((r for r in daqui if r.estado == e), key=lambda r: r.caminho):
                    extra = "; ".join(r.detalhes)
                    if e == "ilegivel":
                        extra = "sem permissão para ler (rode com sudo)"
                    print(f"  {ROTULOS[e]:<7}  {r.caminho}" + (f"   {extra}" if extra else ""))
                    if a.diff and e == "difere":
                        for linha in estado.diff(r):
                            print(linha)
            iguais = sum(1 for r in daqui if r.estado == "igual")
            if iguais:
                print(f"  igual    {iguais} arquivo{'s' if iguais != 1 else ''}")
            copias = sorted(r.caminho for r in daqui if r.estado == "copia")
            if copias and a.copias:
                for c in copias:
                    print(f"  cópia    {c}")
            elif copias:
                print(f"  cópias antigas (.antes-*): {len(copias)} (--copias lista)")
        diferencas = contagem["difere"] + contagem["falta"] + contagem["sobra"]
        print()
        if diferencas:
            print(f"Resumo: {diferencas} diferença{'s' if diferencas != 1 else ''} ({contagem['difere']} difere, "
                  f"{contagem['falta']} falta, {contagem['sobra']} sobra)"
                  + (f"; {contagem['ilegivel']} sem ler" if contagem["ilegivel"] else "") + ".")
            if not a.diff:
                print("O --diff mostra o que mudaria em cada arquivo.")
        elif contagem["ilegivel"]:
            print(f"Resumo: igual no que deu para ler; {contagem['ilegivel']} sem ler (rode com sudo).")
        else:
            print("Resumo: o servidor está igual ao repositório.")
    if contagem["difere"] + contagem["falta"] + contagem["sobra"]:
        return 1
    return 3 if contagem["ilegivel"] else 0


if __name__ == "__main__":
    sys.exit(principal(sys.argv[1:]))

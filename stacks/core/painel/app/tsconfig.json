// Só para conferir os tipos (tsc --noEmit, no CI): o Node roda o TypeScript direto, sem compilar, então
// vale só a sintaxe que ele apaga (erasableSyntaxOnly).
{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}

# Segredos do LiteLLM. O install.sh gera este arquivo como .env (permissão 600).
# Nunca coloque valores reais aqui.
ANTHROPIC_API_KEY=          # gravada pelo comando atena-chave-anthropic
LITELLM_MASTER_KEY=         # gerada pelo install.sh
LITELLM_SALT_KEY=           # gerada pelo install.sh
POSTGRES_PASSWORD=          # gerada pelo install.sh
REDIS_PASSWORD=             # gerada pelo install.sh

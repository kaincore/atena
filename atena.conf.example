# Configuração do servidor Atena.
# Copie para atena.conf, ajuste os valores e rode: sudo ./install.sh
# Os valores de exemplo abaixo NÃO funcionam sem ajuste.

# --- Rede de casa -----------------------------------------------------------
# Interface de rede do servidor (veja com: ip -br link)
ATENA_LAN_IF=enp3s0
# IP fixo do servidor na rede de casa
ATENA_LAN_IP=192.168.0.10
# Faixa da rede de casa: todos os aparelhos dela acessam os serviços
ATENA_LAN_CIDR=192.168.0.0/24
# Roteador: o único endereço da rede de casa que os containers alcançam (DNS)
ATENA_ROUTER_IP=192.168.0.1

# --- Administração ----------------------------------------------------------
# Usuário que entra por SSH e administra o servidor (precisa ter chave SSH configurada)
ATENA_ADMIN_USER=atena

# --- Opcionais --------------------------------------------------------------
# GPU NVIDIA: "nvidia" instala driver + Container Toolkit; "none" pula
ATENA_GPU=none
# Série do driver NVIDIA. 580 é a última que suporta placas Pascal (GTX 10xx).
ATENA_NVIDIA_SERIES=580
# Tailscale para acesso fora de casa: "sim" ou "nao"
ATENA_TAILSCALE=sim
# Voz da Atena (respostas em áudio no Telegram, geradas em casa pelo Kokoro): "sim" ou "nao".
# Precisa de ATENA_GPU=nvidia e da stack ai/voz no ar.
ATENA_VOZ=nao
# Chip da placa-mãe que lê as ventoinhas (sistema.sensores). Vazio: só CPU, NVMe e GPU.
# Para descobrir: sudo apt install lm-sensors && sudo sensors-detect (sugere o módulo, ex.: nct6683)
ATENA_SENSORES_MODULO=

# --- Avisos e agenda --------------------------------------------------------
# Fuso horário dos agendamentos (Hermes) e dos registros
ATENA_TZ=America/Sao_Paulo
# Endereço do ntfy que o celular usa. Os botões de aprovação chamam este endereço.
#   Só em casa:    http://<ATENA_LAN_IP>:2586
#   Com Tailscale: https://<nome-do-servidor>.<sua-tailnet>.ts.net:2586 (com tailscale serve)
ATENA_NTFY_URL=http://192.168.0.10:2586

# --- Modelos de casa (texto privado sem nuvem) --------------------------------
# Modelo do Ollama no servidor para o executor (local.processar). Baixe uma vez com:
#   docker exec ollama ollama pull qwen3:4b-instruct-2507-q4_K_M
ATENA_LOCAL_MODELO=qwen3:4b-instruct-2507-q4_K_M
# Contexto (tokens) do modelo do servidor: mais contexto, mais memória de vídeo
ATENA_LOCAL_CONTEXTO=8192

# --- Lab: o Claude Code programa para você (opcional, ./install.sh --lab) -------
# Contas do Claude Code (Pro ou Max) que o lab usa, separadas por espaço. São só nomes: o login de
# cada uma é com sudo atena-claude-conta entrar <nome>. Com uma conta só, a Atena nem pergunta.
ATENA_CLAUDE_CONTAS=principal
# Quando uma conta bate o limite de uso no meio de um trabalho, ele para e a Atena avisa. Com "sim",
# ele passa sozinho para a próxima conta com login e continua a mesma conversa.
ATENA_CLAUDE_TROCA=nao
# Versão do Claude Code do lab (fixa; ele não se atualiza sozinho)
ATENA_CLAUDE_VERSAO=2.1.302
# Skills no Claude Code do lab: com "sim", cada conta ganha os plugins frontend-design,
# mattpocock-skills, pyright-lsp e typescript-lsp e a skill Impeccable (só o texto, numa versão
# fixa); a Atena escolhe a skill de cada trabalho, e o Claude Code confere as telas com prints
# (atena-tela, com um Chromium sem tela). Baixa cerca de 400 MB.
ATENA_CLAUDE_SKILLS=nao

# --- Painel (opcional, ./install.sh --painel) -----------------------------------
# Fora de casa o painel abre só pelo Tailscale, em HTTPS. Com "sim", ele também abre na rede de casa,
# sem o Tailscale, em http://<ATENA_LAN_IP>:3100. Lá é HTTP puro: a senha e a sessão passam abertas no
# Wi-Fi (qualquer aparelho da rede consegue lê-las), o cookie vai também para os outros serviços do
# mesmo IP, e o painel não instala como app nem guarda as telas no celular.
ATENA_PAINEL_CASA=nao

# --- PC da rede de casa (opcional) -------------------------------------------
# Um PC com placa de vídeo e LM Studio que a Atena liga (Wake-on-LAN), usa para textos
# maiores e desliga quando você pede. Deixe ATENA_PC_IP vazio para não usar.
ATENA_PC_IP=
# MAC da placa de rede do PC (Wake-on-LAN ligado na BIOS e no Windows)
ATENA_PC_MAC=
# Porta da API do LM Studio no PC (só o servidor deve alcançá-la)
ATENA_PC_PORTA=1234
# Modelo carregado no LM Studio e contexto (tokens)
ATENA_PC_MODELO=qwen3-14b
ATENA_PC_CONTEXTO=16384
# Usuário do Windows que aceita a chave restrita da Atena (só desligar, reiniciar e cancelar).
# Veja host/windows/LEIAME.md. Vazio: a Atena só liga o PC.
ATENA_PC_USUARIO=

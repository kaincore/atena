[Unit]
Description=Atena: fila de trabalhos do Claude Code no lab

[Path]
# só os trabalhos (*.json); pedidos de permissão e respostas também passam pela fila
PathExistsGlob=/var/lib/atena-claude/fila/*.json
# e as marcas de trabalho em andamento: depois de uma queda de energia, o runner sobe sozinho e fecha
# como interrompido o que ficou pela metade (ele sempre apaga as marcas ao subir: não sobe em volta)
PathExistsGlob=/var/lib/atena-claude/registros/*.andamento

[Install]
WantedBy=paths.target

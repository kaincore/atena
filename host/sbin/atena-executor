#!/usr/bin/env python3
"""Atena: executor de ações do servidor. O código fica no pacote atena_executor, em
/usr/local/lib/atena-executor (no repositório, host/executor); o que ele faz está no __init__.py de lá."""
import sys

sys.dont_write_bytecode = True   # quem roda como root (os comandos de token) não deixa cache na pasta
sys.path.insert(0, "/usr/local/lib/atena-executor")
from atena_executor.servidor import principal  # noqa: E402

principal()
